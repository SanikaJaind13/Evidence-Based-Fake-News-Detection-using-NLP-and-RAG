# Copy this file to ".env" and fill in your keys:   cp .env.example .env
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Optional tuning
GROQ_MODEL=llama-3.3-70b-versatile
MAX_CLAIMS=3
RESULTS_PER_CLAIM=5
PASSAGES_PER_CLAIM=6
REQUEST_TIMEOUT=12

# Login session lifetime in hours
SESSION_TTL_HOURS=168
# Reuse fetched news for this many minutes (saves Tavily credits)
NEWS_CACHE_MINUTES=60
# Time window, in days, for trending headlines
TRENDING_WINDOW_DAYS=7
# Tesseract languages for image uploads
OCR_LANGS=eng+hin+mar